# --- Database ---
DATABASE_URL=postgresql+psycopg://solna:solna@postgres:5432/solna

# --- Object storage (MinIO locally; leave S3_ENDPOINT empty for real AWS S3) ---
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000   # used to build browser-facing photo URLs
S3_BUCKET=solna-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# --- App ---
PUBLIC_BASE_URL=http://localhost:8000      # used to build the QR gallery URL
GALLERY_TOKEN_BYTES=16
INGEST_API_KEY=dev-ingest-key              # shared secret between watcher and API
GALLERY_POLL_INTERVAL_MS=3000

# --- FTP intake (local dev) ---
FTP_HOST=localhost
FTP_PORT=21
# Local directory the FTP server writes into and the watcher observes.
# Layout: ${FTP_ROOT}/raw/{event_id}/<photo>
FTP_ROOT=/data/ftp
