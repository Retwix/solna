# --- Database ---
DATABASE_URL=postgresql+psycopg://solna:solna@postgres:5432/solna

# --- Object storage (MinIO locally; leave S3_ENDPOINT empty for real AWS S3) ---
S3_ENDPOINT=http://minio:9000             # internal (compose network) — container port
S3_PUBLIC_ENDPOINT=http://localhost:9100   # browser-facing photo URLs — host port
S3_BUCKET=solna-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# --- App ---
# Public base URL the QR/gallery link points to = the WEB APP (not the API).
# Dev: the Vite dev server. Prod: your gallery domain.
PUBLIC_BASE_URL=http://localhost:5173
# Internal URL the watcher uses to reach the API (service name inside compose).
API_INTERNAL_URL=http://api:8000
GALLERY_TOKEN_BYTES=16
INGEST_API_KEY=dev-ingest-key              # shared secret between watcher and API
GALLERY_POLL_INTERVAL_MS=3000

# --- Face recognition (V1) ---
FACE_SERVICE_URL=http://faceservice:9000   # internal (compose network)
# insightface = real recognition (downloads ~300MB model on first run)
# fake        = deterministic stub, no download — for plumbing/dev only
FACE_ENGINE=insightface
INSIGHTFACE_MODEL=buffalo_l
# Cosine similarity in [-1,1]; >= this counts as a match. TUNE on real photos.
MATCH_SIMILARITY_THRESHOLD=0.35

# --- FTP intake ---
# Host shown in the credentials returned at event creation. For a CAMERA (a
# separate device), set this to your computer's LAN IP, e.g. 192.168.1.42 — not
# localhost. localhost only works for an FTP client on this same machine.
FTP_HOST=localhost
FTP_PORT=2121
# Address advertised to clients for passive-mode data transfers. MUST be your
# LAN IP for a camera, or passive transfers will hang. Leave empty for
# same-machine testing.
FTP_PASV_ADDRESS=
FTP_PASV_MIN_PORT=21100
FTP_PASV_MAX_PORT=21110
# Directory the FTP server writes into and the watcher observes (inside compose).
# Layout: ${FTP_ROOT}/raw/{event_id}/<photo>
FTP_ROOT=/data/ftp
